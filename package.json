{
  "name": "tuition-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "test": "npm run test:emulated",
    "test:emulated": "firebase emulators:exec --only firestore,auth 'vitest run'",
    "test:unit": "vitest run",
    "test:rules": "vitest run test/firestore.rules.test.ts",
    "test:endpoints": "vitest run test/server.endpoints.test.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview --port 3000",
    "start": "tsx server.ts"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/qrcode": "^1.5.6",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^15.35.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
