# ==========================================
# Zero-Cost Backend Environment Configuration
# ==========================================

# Server Host & Port
PORT=3000
NODE_ENV=production

# Client API Base URL (leave blank if running full-stack on same origin, or set your Cloudflare Tunnel URL)
VITE_API_BASE_URL=

# CORS Allowed Origins (comma-separated, or leave blank to accept your frontend domain)
ALLOWED_ORIGIN=https://laughing-pod-9v4kj.web.app,https://laughing-pod-9v4kj.firebaseapp.com

# Firebase Admin Service Account Key Path (Firebase Spark tier: Auth, Firestore, Hosting)
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Place file securely on your server/Termux/VPS and reference the path below (NEVER commit secrets!)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Optional: Initial Administrator Bootstrap Secret
ADMIN_BOOTSTRAP_SECRET=
ADMIN_EMAIL=masskingslin@gmail.com

# Zero-Cost Payments: Direct UPI & Bharat QR (No payment gateway fees)
# Handled via institute VPA configured in school_info (e.g. apex.academy@okaxis)

# Zero-Cost Messaging:
# Free In-App notifications + self-hosted FCM push via Firebase Admin
# Free WhatsApp Click-to-Chat links via wa.me (No WhatsApp Cloud API charges)
