# ==========================================
# Zero-Cost Backend Environment Configuration
# ==========================================

# Server Host & Port
PORT=3000
NODE_ENV=production

# Client API Base URL (leave blank if running full-stack on same origin, or set your Cloudflare Tunnel URL)
VITE_API_BASE_URL=https://api.yourdomain.com

# 1. ALLOWED_ORIGIN (REQUIRED in production)
# Comma-separated list of allowed web frontend origins for CORS security
ALLOWED_ORIGIN=https://laughing-pod-9v4kj.web.app,https://laughing-pod-9v4kj.firebaseapp.com

# 2. FIREBASE_SERVICE_ACCOUNT_PATH (REQUIRED in production)
# Absolute or relative path to downloaded Firebase service account JSON key file
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# 3. ADMIN_BOOTSTRAP_SECRET (REQUIRED in production)
# Secret passkey used during initial bootstrap (/api/bootstrapFirstAdmin) to initialize the first admin
ADMIN_BOOTSTRAP_SECRET=your_super_secret_admin_bootstrap_key_change_me

# Optional: Administrator Email fallback
ADMIN_EMAIL=admin@institution.edu
