package com.tuition.core.network

import okhttp3.OkHttpClient
import okhttp3.logging.HttpLoggingInterceptor
import retrofit2.Response
import retrofit2.Retrofit
import retrofit2.converter.gson.GsonConverterFactory
import retrofit2.http.*
import java.util.concurrent.TimeUnit

interface ApiService {

    // Classes / Courses
    @GET("api/v1/classes")
    suspend fun getAvailableClasses(
        @Query("subject") subject: String? = null,
        @Query("grade") grade: String? = null
    ): Response<List<TuitionClass>>

    @GET("api/v1/classes/{id}")
    suspend fun getClassById(@Path("id") id: String): Response<TuitionClass>

    @POST("api/v1/classes")
    suspend fun createClass(@Body tuitionClass: TuitionClass): Response<TuitionClass>

    @DELETE("api/v1/classes/{id}")
    suspend fun deleteClass(@Path("id") id: String): Response<Unit>

    // Bookings & Enrollments
    @POST("api/v1/bookings")
    suspend fun createBooking(@Body booking: Booking): Response<Booking>

    @GET("api/v1/bookings/student/{studentId}")
    suspend fun getStudentBookings(@Path("studentId") studentId: String): Response<List<Booking>>

    @GET("api/v1/bookings/teacher/{teacherId}")
    suspend fun getTeacherBookings(@Path("teacherId") teacherId: String): Response<List<Booking>>

    @PATCH("api/v1/bookings/{id}/status")
    suspend fun updateBookingStatus(
        @Path("id") id: String,
        @Query("status") status: String
    ): Response<Booking>

    // Assignments
    @GET("api/v1/classes/{classId}/assignments")
    suspend fun getAssignments(@Path("classId") classId: String): Response<List<Assignment>>

    @POST("api/v1/classes/{classId}/assignments")
    suspend fun createAssignment(
        @Path("classId") classId: String,
        @Body assignment: Assignment
    ): Response<Assignment>

    // Submissions
    @POST("api/v1/assignments/{assignmentId}/submit")
    suspend fun submitAssignment(
        @Path("assignmentId") assignmentId: String,
        @Body submission: Submission
    ): Response<Submission>

    @GET("api/v1/assignments/{assignmentId}/submissions")
    suspend fun getSubmissions(@Path("assignmentId") assignmentId: String): Response<List<Submission>>

    @PATCH("api/v1/submissions/{submissionId}/grade")
    suspend fun gradeSubmission(
        @Path("submissionId") submissionId: String,
        @Query("score") score: Int,
        @Query("feedback") feedback: String
    ): Response<Submission>

    // Attendance
    @POST("api/v1/classes/{classId}/attendance")
    suspend fun submitAttendance(
        @Path("classId") classId: String,
        @Body records: List<AttendanceRecord>
    ): Response<Unit>
}

object TuitionApiClient {
    private const val BASE_URL = "https://api.tuitionplatform.internal/"

    fun create(baseUrl: String = BASE_URL): ApiService {
        val loggingInterceptor = HttpLoggingInterceptor().apply {
            level = HttpLoggingInterceptor.Level.BODY
        }

        val okHttpClient = OkHttpClient.Builder()
            .addInterceptor(loggingInterceptor)
            .connectTimeout(30, TimeUnit.SECONDS)
            .readTimeout(30, TimeUnit.SECONDS)
            .writeTimeout(30, TimeUnit.SECONDS)
            .build()

        return Retrofit.Builder()
            .baseUrl(baseUrl)
            .client(okHttpClient)
            .addConverterFactory(GsonConverterFactory.create())
            .build()
            .create(ApiService::class.java)
    }
}
