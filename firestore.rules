rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return hasUserDoc() ? getUserData().role : 'STUDENT';
    }

    function isTeacherOrAdmin() {
      return isSignedIn() && (getUserRole() == 'TEACHER' || getUserRole() == 'ADMIN');
    }

    function isLinkedParentOf(studentId) {
      return isSignedIn() && hasUserDoc() && (
        getUserData().role == 'PARENT' &&
        ('linkedChildIds' in getUserData()) &&
        (studentId in getUserData().linkedChildIds)
      );
    }

    function canAccessStudentData(studentId) {
      return isSignedIn() && (
        request.auth.uid == studentId ||
        (hasUserDoc() && 'studentId' in getUserData() && getUserData().studentId == studentId) ||
        isLinkedParentOf(studentId) ||
        isTeacherOrAdmin()
      );
    }

    function isStudentInBatch(batchId) {
      return isSignedIn() && (
        isTeacherOrAdmin() || (
          hasUserDoc() && (
            (getUserRole() == 'STUDENT' && (
              ('enrolledBatchIds' in getUserData() && batchId in getUserData().enrolledBatchIds) ||
              ('studentIds' in resource.data && (
                request.auth.uid in resource.data.studentIds ||
                ('studentId' in getUserData() && getUserData().studentId in resource.data.studentIds)
              ))
            )) ||
            (getUserRole() == 'PARENT' && (
              ('enrolledBatchIds' in getUserData() && batchId in getUserData().enrolledBatchIds) ||
              ('studentIds' in resource.data && 'linkedChildIds' in getUserData() && resource.data.studentIds.hasAny(getUserData().linkedChildIds))
            ))
          )
        )
      );
    }

    // 1. Users collection
    // Users CANNOT set or change their own role or isSchoolAdmin.
    // New users can only sign up as STUDENT unless verified by admin/Cloud Function.
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isTeacherOrAdmin());
      allow list: if isTeacherOrAdmin();
      allow create: if isSignedIn() && (
        isTeacherOrAdmin() || (
          request.auth.uid == userId &&
          request.resource.data.role == 'STUDENT' &&
          (!('isSchoolAdmin' in request.resource.data) || request.resource.data.isSchoolAdmin == false)
        )
      );
      allow update: if isSignedIn() && (
        isTeacherOrAdmin() || (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          (!('isSchoolAdmin' in request.resource.data) || request.resource.data.isSchoolAdmin == resource.data.isSchoolAdmin)
        )
      );
      allow delete: if isTeacherOrAdmin();
    }

    // 2. Batches collection - Scoped to enrolled students, linked parents, or faculty
    match /batches/{batchId} {
      allow get: if isStudentInBatch(batchId);
      allow list: if isTeacherOrAdmin() || (
        isSignedIn() && hasUserDoc() && (
          (getUserRole() == 'STUDENT' && (
            ('enrolledBatchIds' in getUserData() && resource.id in getUserData().enrolledBatchIds) ||
            ('studentIds' in resource.data && (
              request.auth.uid in resource.data.studentIds ||
              ('studentId' in getUserData() && getUserData().studentId in resource.data.studentIds)
            ))
          )) ||
          (getUserRole() == 'PARENT' && (
            ('enrolledBatchIds' in getUserData() && resource.id in getUserData().enrolledBatchIds) ||
            ('studentIds' in resource.data && 'linkedChildIds' in getUserData() && resource.data.studentIds.hasAny(getUserData().linkedChildIds))
          ))
        )
      );
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 3. Attendance collection - Writable ONLY by teachers/admins
    match /attendance/{attendanceId} {
      allow get: if isSignedIn() && canAccessStudentData(resource.data.studentId);
      allow list: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (hasUserDoc() && getUserRole() == 'STUDENT' && (resource.data.studentId == request.auth.uid || ('studentId' in getUserData() && resource.data.studentId == getUserData().studentId))) ||
        (hasUserDoc() && getUserRole() == 'PARENT' && isLinkedParentOf(resource.data.studentId))
      );
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 4. Assignments collection - Scoped to enrolled batch
    match /assignments/{assignmentId} {
      allow get, list: if isTeacherOrAdmin() || (
        isSignedIn() && hasUserDoc() && (
          (getUserRole() == 'STUDENT' && (
            ('enrolledBatchIds' in getUserData() && resource.data.batchId in getUserData().enrolledBatchIds) ||
            ('studentIds' in resource.data && (
              request.auth.uid in resource.data.studentIds ||
              ('studentId' in getUserData() && getUserData().studentId in resource.data.studentIds)
            ))
          )) ||
          (getUserRole() == 'PARENT' && (
            ('enrolledBatchIds' in getUserData() && resource.data.batchId in getUserData().enrolledBatchIds) ||
            ('studentIds' in resource.data && 'linkedChildIds' in getUserData() && resource.data.studentIds.hasAny(getUserData().linkedChildIds))
          ))
        )
      );
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 5. Submissions collection - Students write ONLY their own
    match /submissions/{submissionId} {
      allow get: if isSignedIn() && canAccessStudentData(resource.data.studentId);
      allow list: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (hasUserDoc() && getUserRole() == 'STUDENT' && (resource.data.studentId == request.auth.uid || ('studentId' in getUserData() && resource.data.studentId == getUserData().studentId))) ||
        (hasUserDoc() && getUserRole() == 'PARENT' && isLinkedParentOf(resource.data.studentId))
      );
      allow create: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (request.resource.data.studentId == request.auth.uid) ||
        (hasUserDoc() && 'studentId' in getUserData() && request.resource.data.studentId == getUserData().studentId)
      );
      allow update: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (resource.data.studentId == request.auth.uid && request.resource.data.studentId == request.auth.uid) ||
        (hasUserDoc() && 'studentId' in getUserData() && resource.data.studentId == getUserData().studentId && request.resource.data.studentId == getUserData().studentId)
      );
      allow delete: if isTeacherOrAdmin();
    }

    // 6. Fees collection - Writable ONLY by teachers/admins or Cloud Functions/webhooks
    match /fees/{feeId} {
      allow get: if isSignedIn() && canAccessStudentData(resource.data.studentId);
      allow list: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (hasUserDoc() && getUserRole() == 'STUDENT' && (resource.data.studentId == request.auth.uid || ('studentId' in getUserData() && resource.data.studentId == getUserData().studentId))) ||
        (hasUserDoc() && getUserRole() == 'PARENT' && isLinkedParentOf(resource.data.studentId))
      );
      allow create, delete: if isTeacherOrAdmin();
      allow update: if isTeacherOrAdmin() || (
        // Students/Parents can only set PENDING_APPROVAL on their own fee (cannot mark PAID or alter amounts)
        canAccessStudentData(resource.data.studentId) &&
        request.resource.data.status == 'PENDING_APPROVAL' &&
        resource.data.status != 'PAID' &&
        request.resource.data.amountPaid == resource.data.amountPaid &&
        request.resource.data.amountDue == resource.data.amountDue
      );
    }

    // 7. Announcements collection - Scoped to enrolled batch or public ALL
    match /announcements/{announcementId} {
      allow get, list: if isTeacherOrAdmin() || (
        isSignedIn() && (
          !('batchId' in resource.data) ||
          resource.data.batchId == 'ALL' ||
          (hasUserDoc() && (
            (getUserRole() == 'STUDENT' && 'enrolledBatchIds' in getUserData() && resource.data.batchId in getUserData().enrolledBatchIds) ||
            (getUserRole() == 'PARENT' && 'enrolledBatchIds' in getUserData() && resource.data.batchId in getUserData().enrolledBatchIds)
          ))
        )
      );
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 8. Doubts collection - Students read and write ONLY their own; faculty all
    match /doubts/{doubtId} {
      allow get, list: if isTeacherOrAdmin() || (
        isSignedIn() && (
          resource.data.studentId == request.auth.uid ||
          (hasUserDoc() && 'studentId' in getUserData() && resource.data.studentId == getUserData().studentId)
        )
      );
      allow create: if isSignedIn() && (
        isTeacherOrAdmin() ||
        request.resource.data.studentId == request.auth.uid ||
        (hasUserDoc() && 'studentId' in getUserData() && request.resource.data.studentId == getUserData().studentId)
      );
      allow update, delete: if isTeacherOrAdmin() || (
        isSignedIn() && (
          resource.data.studentId == request.auth.uid ||
          (hasUserDoc() && 'studentId' in getUserData() && resource.data.studentId == getUserData().studentId)
        )
      );
    }

    // 9. Educational Resources - Scoped to enrolled batch or public ALL
    match /resources/{resourceId} {
      allow get, list: if isTeacherOrAdmin() || (
        isSignedIn() && (
          resource.data.batchId == 'ALL' ||
          (hasUserDoc() && (
            (getUserRole() == 'STUDENT' && 'enrolledBatchIds' in getUserData() && resource.data.batchId in getUserData().enrolledBatchIds) ||
            (getUserRole() == 'PARENT' && 'enrolledBatchIds' in getUserData() && resource.data.batchId in getUserData().enrolledBatchIds)
          ))
        )
      );
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 10. Notifications - Writable ONLY by teachers/admins
    match /notifications/{notificationId} {
      allow read, list: if isSignedIn() && (
        isTeacherOrAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.targetRole == 'ALL' ||
        (hasUserDoc() && resource.data.targetRole == getUserRole())
      );
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 11. Classroom Rooms - Scoped to enrolled batches or faculty
    match /rooms/{roomId} {
      allow get, list: if isTeacherOrAdmin() || (
        isSignedIn() && hasUserDoc() && (
          !('batchIds' in resource.data) ||
          (getUserRole() == 'STUDENT' && 'enrolledBatchIds' in getUserData() && resource.data.batchIds.hasAny(getUserData().enrolledBatchIds)) ||
          (getUserRole() == 'PARENT' && 'enrolledBatchIds' in getUserData() && resource.data.batchIds.hasAny(getUserData().enrolledBatchIds))
        )
      );
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 12. Schedule slots - Scoped to enrolled batch
    match /schedule_slots/{slotId} {
      allow get, list: if isTeacherOrAdmin() || (
        isSignedIn() && hasUserDoc() && (
          (getUserRole() == 'STUDENT' && 'enrolledBatchIds' in getUserData() && resource.data.batchId in getUserData().enrolledBatchIds) ||
          (getUserRole() == 'PARENT' && 'enrolledBatchIds' in getUserData() && resource.data.batchId in getUserData().enrolledBatchIds)
        )
      );
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 13. Parent links - Only creator student and faculty can read; parents redeem via Cloud Function
    match /parent_links/{codeId} {
      allow get, list: if isTeacherOrAdmin() || (
        isSignedIn() && (
          resource.data.studentId == request.auth.uid ||
          (hasUserDoc() && 'studentId' in getUserData() && resource.data.studentId == getUserData().studentId)
        )
      );
      allow create: if isSignedIn() && (
        isTeacherOrAdmin() ||
        request.resource.data.studentId == request.auth.uid ||
        (hasUserDoc() && 'studentId' in getUserData() && request.resource.data.studentId == getUserData().studentId)
      );
      allow update: if isTeacherOrAdmin() || (
        isSignedIn() && (
          resource.data.studentId == request.auth.uid ||
          (hasUserDoc() && 'studentId' in getUserData() && resource.data.studentId == getUserData().studentId)
        )
      );
      allow delete: if isTeacherOrAdmin();
    }

    // 14. School Info - Institutional public profile (name, counts). Contains NO secret join codes.
    match /school_info/{schoolId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 14b. School Secrets - Sensitive join codes (studentCode, teacherCode)
    // Accessible and readable ONLY to teachers and admins!
    match /school_secrets/{schoolId} {
      allow read, write: if isTeacherOrAdmin();
    }

    // 15. School Members - Teachers and admins read all; members read only their own record
    match /school_members/{memberId} {
      allow get: if isTeacherOrAdmin() || (
        isSignedIn() && (
          memberId == request.auth.uid ||
          (hasUserDoc() && (
            ('studentId' in getUserData() && memberId == getUserData().studentId) ||
            ('teacherId' in getUserData() && memberId == getUserData().teacherId) ||
            ('parentId' in getUserData() && memberId == getUserData().parentId)
          ))
        )
      );
      allow list: if isTeacherOrAdmin();
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 16. Test Results - Scoped to student, linked parents, or faculty
    match /test_results/{testId} {
      allow get: if isSignedIn() && canAccessStudentData(resource.data.studentId);
      allow list: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (hasUserDoc() && getUserRole() == 'STUDENT' && (resource.data.studentId == request.auth.uid || ('studentId' in getUserData() && resource.data.studentId == getUserData().studentId))) ||
        (hasUserDoc() && getUserRole() == 'PARENT' && isLinkedParentOf(resource.data.studentId))
      );
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 17. Notification & Message Logs - Faculty only
    match /notification_logs/{logId} {
      allow read, list: if isTeacherOrAdmin();
      allow create, update, delete: if isTeacherOrAdmin();
    }
  }
}
