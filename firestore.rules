rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return hasUserDoc() ? getUserData().role : 'STUDENT';
    }

    function isTeacherOrAdmin() {
      return isSignedIn() && (getUserRole() == 'TEACHER' || getUserRole() == 'ADMIN');
    }

    function isLinkedParentOf(studentId) {
      return isSignedIn() && hasUserDoc() && (
        getUserData().role == 'PARENT' &&
        ('linkedChildIds' in getUserData()) &&
        (studentId in getUserData().linkedChildIds)
      );
    }

    function canAccessStudentData(studentId) {
      return isSignedIn() && (
        request.auth.uid == studentId ||
        (hasUserDoc() && 'studentId' in getUserData() && getUserData().studentId == studentId) ||
        isLinkedParentOf(studentId) ||
        isTeacherOrAdmin()
      );
    }

    // 1. Users collection
    // Users CANNOT set or change their own role or isSchoolAdmin.
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isTeacherOrAdmin());
      allow list: if isTeacherOrAdmin();
      allow create: if isSignedIn() && (
        isTeacherOrAdmin() || (
          request.auth.uid == userId &&
          request.resource.data.role == 'STUDENT' &&
          (!('isSchoolAdmin' in request.resource.data) || request.resource.data.isSchoolAdmin == false)
        )
      );
      allow update: if isSignedIn() && (
        isTeacherOrAdmin() || (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          (!('isSchoolAdmin' in request.resource.data) || request.resource.data.isSchoolAdmin == resource.data.isSchoolAdmin)
        )
      );
      allow delete: if isTeacherOrAdmin();
    }

    // 2. Batches collection
    match /batches/{batchId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 3. Attendance collection - Writable ONLY by teachers/admins
    match /attendance/{attendanceId} {
      allow get: if isSignedIn() && canAccessStudentData(resource.data.studentId);
      allow list: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (hasUserDoc() && getUserRole() == 'STUDENT' && resource.data.studentId == request.auth.uid) ||
        (hasUserDoc() && getUserRole() == 'PARENT' && isLinkedParentOf(resource.data.studentId))
      );
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 4. Assignments collection
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 5. Submissions collection - Students write ONLY their own
    match /submissions/{submissionId} {
      allow get: if isSignedIn() && canAccessStudentData(resource.data.studentId);
      allow list: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (hasUserDoc() && getUserRole() == 'STUDENT' && resource.data.studentId == request.auth.uid) ||
        (hasUserDoc() && getUserRole() == 'PARENT' && isLinkedParentOf(resource.data.studentId))
      );
      allow create: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (request.resource.data.studentId == request.auth.uid)
      );
      allow update: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (resource.data.studentId == request.auth.uid && request.resource.data.studentId == request.auth.uid)
      );
      allow delete: if isTeacherOrAdmin();
    }

    // 6. Fees collection - Writable ONLY by teachers/admins or Cloud Functions/webhooks
    match /fees/{feeId} {
      allow get: if isSignedIn() && canAccessStudentData(resource.data.studentId);
      allow list: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (hasUserDoc() && getUserRole() == 'STUDENT' && resource.data.studentId == request.auth.uid) ||
        (hasUserDoc() && getUserRole() == 'PARENT' && isLinkedParentOf(resource.data.studentId))
      );
      allow create, delete: if isTeacherOrAdmin();
      allow update: if isTeacherOrAdmin() || (
        // Students/Parents can only submit manual payment claims (cannot mark paid or alter amount)
        canAccessStudentData(resource.data.studentId) &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.amountPaid == resource.data.amountPaid &&
        request.resource.data.amountDue == resource.data.amountDue
      );
    }

    // 7. Announcements collection
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 8. Doubts collection - Students write ONLY their own
    match /doubts/{doubtId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (request.resource.data.studentId == request.auth.uid)
      );
      allow update: if isTeacherOrAdmin() || (
        isSignedIn() && resource.data.studentId == request.auth.uid && request.resource.data.studentId == request.auth.uid
      );
      allow delete: if isTeacherOrAdmin() || (
        isSignedIn() && resource.data.studentId == request.auth.uid
      );
    }

    // 9. Educational Resources
    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 10. Notifications - Writable ONLY by teachers/admins
    match /notifications/{notificationId} {
      allow read, list: if isSignedIn() && (
        isTeacherOrAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.targetRole == 'ALL' ||
        (hasUserDoc() && resource.data.targetRole == getUserRole())
      );
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 11. Classroom Rooms
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 12. Schedule slots
    match /schedule_slots/{slotId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 13. Parent links
    match /parent_links/{codeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isTeacherOrAdmin() || request.resource.data.studentId == request.auth.uid);
      allow update: if isSignedIn() && (isTeacherOrAdmin() || resource.data.studentId == request.auth.uid);
      allow delete: if isTeacherOrAdmin();
    }

    // 14. School Info
    match /school_info/{schoolId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 15. School Members
    match /school_members/{memberId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 16. Test Results
    match /test_results/{testId} {
      allow get: if isSignedIn() && canAccessStudentData(resource.data.studentId);
      allow list: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (hasUserDoc() && getUserRole() == 'STUDENT' && resource.data.studentId == request.auth.uid) ||
        (hasUserDoc() && getUserRole() == 'PARENT' && isLinkedParentOf(resource.data.studentId))
      );
      allow create, update, delete: if isTeacherOrAdmin();
    }

    // 17. Notification & Message Logs
    match /notification_logs/{logId} {
      allow read, list: if isTeacherOrAdmin();
      allow create, update, delete: if isTeacherOrAdmin();
    }
  }
}
